{
  "manifest_version": 3,
  "name": "RelayPilot",
  "version": "0.4.0",
  "description": "Explicit, evidence-first browser and local task control.",
  "action": {"default_title": "RelayPilot", "default_popup": "popup.html"},
  "background": {"service_worker": "background.js", "type": "module"},
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8721/*"],
  "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Open RelayPilot"}}
}
